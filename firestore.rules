rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Funciones auxiliares de seguridad
    // ─────────────────────────────────────────────────────────────
    function estaAutenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function usuarioDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return estaAutenticado() && (
        request.auth.token.admin == true ||
        usuarioDoc().role == 'ADMIN'
      );
    }

    function noEstaBaneado() {
      return estaAutenticado() && (
        !('banned' in usuarioDoc()) || usuarioDoc().banned == false
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: users
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if estaAutenticado();

      // Registro inicial: rol 'USUARIO' o cuenta inicial 'ADMIN' para admin@encargo.com
      allow create: if esPropietario(userId)
                    && (request.resource.data.role == 'USUARIO' || (request.auth.token.email == 'admin@encargo.com' && request.resource.data.role == 'ADMIN'))
                    && request.resource.data.banned == false;

      // Actualización:
      // - ADMIN puede gestionar roles y baneos (protegiendo admin@encargo.com y auto-degradación).
      // - El propietario puede editar perfil, recargar billetera simulada, o participar en custodia
      //   sin poder cambiar su role, banned, ni reducirse strikes/suspensiones.
      // - Contraparte de acuerdo en transacción atómica puede liberar pago (92%) o registrar falta/penalización.
      allow update: if (
        esAdmin()
        && !(resource.data.email == 'admin@encargo.com' && (request.resource.data.role != 'ADMIN' || request.resource.data.banned == true))
        && !(request.auth.uid == userId && request.resource.data.role != resource.data.role)
      ) || (
        esPropietario(userId)
        && noEstaBaneado()
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.get('strikes', 0) >= resource.data.get('strikes', 0)
        && request.resource.data.get('suspendedUntil', null) == resource.data.get('suspendedUntil', null)
      ) || (
        noEstaBaneado()
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.email == resource.data.email
        && (
          request.resource.data.get('walletBalance', 0) >= resource.data.get('walletBalance', 0) ||
          request.resource.data.get('strikes', 0) > resource.data.get('strikes', 0)
        )
      );

      allow delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: solicitudes
    // ─────────────────────────────────────────────────────────────
    match /solicitudes/{solicitudId} {
      allow read: if true;

      allow create: if noEstaBaneado()
                    && request.resource.data.autor_uid == request.auth.uid
                    && request.resource.data.estado == 'PUBLICADO';

      // Actualización / Acuerdos / Custodia / Completado / Incumplimiento:
      // - ADMIN o autor original, O
      // - Prestador asignado (providerUid == request.auth.uid) para confirmar finalización o reportar incumplimiento, O
      // - Contraparte cerrando el acuerdo desde PUBLICADO -> en_progreso en transacción atómica.
      allow update: if esAdmin() || (
        noEstaBaneado() && (
          resource.data.autor_uid == request.auth.uid ||
          resource.data.providerUid == request.auth.uid ||
          (resource.data.estado == 'PUBLICADO' && request.resource.data.providerUid == request.auth.uid)
        )
      );

      allow delete: if esAdmin() || (
        noEstaBaneado() && resource.data.autor_uid == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: chats y mensajes
    // ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if estaAutenticado() && request.auth.uid in resource.data.participantes;
      allow create: if noEstaBaneado() && request.auth.uid in request.resource.data.participantes;
      allow update: if noEstaBaneado() && request.auth.uid in resource.data.participantes;
      allow delete: if esAdmin();

      match /mensajes/{mensajeId} {
        allow read: if estaAutenticado() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow create: if noEstaBaneado()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes
                      && (request.resource.data.senderId == request.auth.uid || request.resource.data.remitenteId == request.auth.uid);
        allow update, delete: if esAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: penalties (Auditoría inmutable de faltas y sanciones)
    // ─────────────────────────────────────────────────────────────
    match /penalties/{penaltyId} {
      allow read: if esAdmin() || (estaAutenticado() && (resource.data.userId == request.auth.uid || resource.data.reportedByUid == request.auth.uid));
      allow create: if noEstaBaneado() && request.resource.data.reportedByUid == request.auth.uid;
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: transactions (Comprobantes de billetera COP)
    // ─────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if esAdmin() || (estaAutenticado() && resource.data.userId == request.auth.uid);
      allow create: if noEstaBaneado();
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: platform_revenue (Comisiones del 8% de la plataforma)
    // ─────────────────────────────────────────────────────────────
    match /platform_revenue/{revId} {
      allow read: if esAdmin();
      allow create: if noEstaBaneado() && request.resource.data.feePercentage == 0.08;
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: reportes
    // ─────────────────────────────────────────────────────────────
    match /reportes/{reporteId} {
      allow create: if noEstaBaneado()
                    && request.resource.data.reportadoPor == request.auth.uid;
      allow read: if esAdmin() || (estaAutenticado() && resource.data.reportadoPor == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: calificaciones
    // ─────────────────────────────────────────────────────────────
    match /calificaciones/{calificacionId} {
      allow read: if true;
      allow create: if noEstaBaneado()
                    && request.resource.data.calificadorId == request.auth.uid
                    && request.resource.data.calificadoId != request.auth.uid
                    && request.resource.data.valor >= 1
                    && request.resource.data.valor <= 5;
      allow update, delete: if esAdmin();
    }
  }
}
