rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Funciones auxiliares de seguridad
    // ─────────────────────────────────────────────────────────────
    function estaAutenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function usuarioExiste(uid) {
      return estaAutenticado() && exists(/databases/$(database)/documents/users/$(uid));
    }

    function usuarioDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function esAdmin() {
      return estaAutenticado() && (
        request.auth.token.admin == true ||
        (usuarioExiste(request.auth.uid) && usuarioDoc(request.auth.uid).get('role', 'USUARIO') == 'ADMIN')
      );
    }

    function noEstaBaneado() {
      return estaAutenticado() && (
        !usuarioExiste(request.auth.uid) ||
        usuarioDoc(request.auth.uid).get('banned', false) == false
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: users
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if estaAutenticado();

      // Registro inicial: rol 'USUARIO' o cuenta inicial 'ADMIN' para admin@encargo.com
      allow create: if esPropietario(userId)
                    && (request.resource.data.get('role', 'USUARIO') == 'USUARIO' || (request.auth.token.email == 'admin@encargo.com' && request.resource.data.role == 'ADMIN'))
                    && request.resource.data.get('banned', false) == false;

      // Actualización:
      // - ADMIN puede gestionar roles y baneos (inmunidad a admin@encargo.com).
      // - El propio usuario puede editar su perfil y recargar billetera simulada.
      // - Usuarios participantes en un acuerdo (transacción atómica de custodia/pago) pueden actualizar saldos y strikes.
      allow update: if (
        esAdmin()
        && !(resource.data.email == 'admin@encargo.com' && (request.resource.data.get('role', 'ADMIN') != 'ADMIN' || request.resource.data.get('banned', false) == true))
        && !(request.auth.uid == userId && request.resource.data.get('role', 'ADMIN') != resource.data.get('role', 'ADMIN'))
      ) || (
        esPropietario(userId)
        && noEstaBaneado()
        && request.resource.data.get('role', 'USUARIO') == resource.data.get('role', 'USUARIO')
        && request.resource.data.get('banned', false) == resource.data.get('banned', false)
      ) || (
        estaAutenticado()
        && noEstaBaneado()
        && request.resource.data.get('role', 'USUARIO') == resource.data.get('role', 'USUARIO')
        && request.resource.data.get('banned', false) == resource.data.get('banned', false)
        && request.resource.data.email == resource.data.email
      );

      allow delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: solicitudes
    // ─────────────────────────────────────────────────────────────
    match /solicitudes/{solicitudId} {
      allow read: if true;

      allow create: if estaAutenticado()
                    && noEstaBaneado()
                    && request.resource.data.autor_uid == request.auth.uid;

      // Actualización:
      // Entre roles de usuario se realizan las postulaciones, acuerdos, custodia y finalización.
      // Permitido para:
      // - Admin o autor de la solicitud.
      // - El prestador/solucionador asignado.
      // - O cualquier usuario autenticado postulándose o acordando sobre una solicitud disponible.
      allow update: if estaAutenticado() && noEstaBaneado() && (
        esAdmin() ||
        resource.data.autor_uid == request.auth.uid ||
        resource.data.get('providerUid', null) == request.auth.uid ||
        request.resource.data.get('providerUid', null) == request.auth.uid ||
        resource.data.get('estado', 'PUBLICADO') in ['PUBLICADO', 'publicado', 'en_progreso', 'acordada']
      );

      allow delete: if esAdmin() || (
        estaAutenticado() && resource.data.autor_uid == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: chats y mensajes (Negociación privada entre usuarios)
    // ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Lectura permitida si el documento aún no existe o si el usuario autenticado participa o es admin
      allow read: if estaAutenticado() && (
        resource == null ||
        request.auth.uid in resource.data.participantes ||
        esAdmin()
      );

      // Creación del chat al postularse: el usuario autenticado debe ser uno de los participantes
      allow create: if estaAutenticado() && noEstaBaneado() && (
        request.auth.uid in request.resource.data.participantes ||
        esAdmin()
      );

      // Actualización del acuerdo (precio, fecha, confirmaciones) por las partes o admin
      allow update: if estaAutenticado() && noEstaBaneado() && (
        request.auth.uid in resource.data.participantes ||
        request.auth.uid in request.resource.data.participantes ||
        esAdmin()
      );

      allow delete: if esAdmin();

      match /mensajes/{mensajeId} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado() && noEstaBaneado() && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.remitenteId == request.auth.uid ||
          request.resource.data.remitente_uid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
        allow update, delete: if esAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: penalties (Auditoría inmutable de faltas y sanciones)
    // ─────────────────────────────────────────────────────────────
    match /penalties/{penaltyId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() && noEstaBaneado();
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: transactions (Comprobantes de billetera COP)
    // ─────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() && noEstaBaneado();
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: platform_revenue (Comisiones del 8% de la plataforma)
    // ─────────────────────────────────────────────────────────────
    match /platform_revenue/{revId} {
      allow read: if esAdmin();
      allow create: if estaAutenticado() && noEstaBaneado();
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: reportes
    // ─────────────────────────────────────────────────────────────
    match /reportes/{reporteId} {
      allow create: if estaAutenticado()
                    && request.resource.data.reportadoPor == request.auth.uid;
      allow read: if esAdmin() || (estaAutenticado() && resource.data.reportadoPor == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Colección: calificaciones
    // ─────────────────────────────────────────────────────────────
    match /calificaciones/{calificacionId} {
      allow read: if true;
      allow create: if estaAutenticado()
                    && request.resource.data.calificadorId == request.auth.uid;
      allow update, delete: if esAdmin();
    }
  }
}
